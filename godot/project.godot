; RAGEQUIT — Godot 4 project.
;
; La base nuova. Misurato sul progetto Three.js: ~11.600 righe rifacevano a mano
; cose che un motore dà di serie (viewmodel, animazioni, post-processing,
; particelle, editor di livelli, fisica) contro ~10.800 righe di regole di gioco
; vere. Quelle regole si portano; l'impalcatura si cancella.

config_version=5

[application]

config/name="RAGEQUIT"
config/description="Arena PvP: scegli una build, entra in arena, combatti."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

; L'audio è un servizio, non un nodo di scena: ogni cosa che suona deve poterlo
; chiamare senza sapere dove sta, e le voci si allocano UNA volta all'avvio
; invece che a ogni colpo.
Audio="*res://src/audio.gd"

; netfox — MIT, v1.35.3. Fa quello che avevo scritto a mano in `lag_comp.gd` e
; nella meta' predittiva di `net_world.gd`: tempo di rete condiviso, predizione
; lato client, riconciliazione lato server, interpolazione e ROLLBACK — che era
; l'unico pezzo che davvero non avevamo.
;
; Si appoggia al multiplayer di alto livello di Godot, che e' agnostico rispetto
; al trasporto: funziona sopra il nostro WebSocket, ed e' la ragione per cui e'
; adottabile senza rimettere in discussione §14.
NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

; 60 Hz fisso, come il server autoritativo del progetto precedente. Il
; determinismo del movimento dipende da un passo fisso: non toccare.
common/physics_ticks_per_second=60
3d/default_gravity=25.0

[rendering]

; COMPATIBILITY OVUNQUE, e non solo sul web.
;
; Forward+ richiede Vulkan e il browser non ce l'ha: un export web da un progetto
; Forward+ resta appeso sulla schermata di caricamento. Ma il punto vero e un
; altro: sviluppare su un renderer e spedirne un altro vuol dire che ogni valore
; visivo che taro e una bugia. Si sviluppa su cio che si spedisce.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.078, 1)

