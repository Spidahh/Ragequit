# Copy this file to .env (which is gitignored) and fill in real values.

# --- Client ---
VITE_SERVER_URL=ws://localhost:2567
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server ---
PORT=2567
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# Optional admin-only Colyseus monitor.
# Keep disabled unless you need it; if enabled, user/password are required.
COLYSEUS_MONITOR_ENABLED=false
COLYSEUS_MONITOR_USER=
COLYSEUS_MONITOR_PASSWORD=

# --- Shared ---
PROTOCOL_VERSION=1
