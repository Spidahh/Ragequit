{
  "name": "ragequit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser PvP arena with class-aware loadouts, active combat, and knockup combos.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "build:shared": "pnpm --filter=@ragequit/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter=./packages/client --filter=./packages/server dev",
    "dev:client": "pnpm build:shared && pnpm --filter=./packages/client dev",
    "dev:server": "pnpm build:shared && pnpm --filter=./packages/server dev",
    "test": "pnpm build:shared && pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "audit:character": "node tools/asset-pipeline/audit-character-glb.mjs packages/client/public/characters/UAL1_Standard.glb",
    "validate:content": "tsx tools/content-validator/validate.ts",
    "check:budget": "node tools/check-file-budget.mjs",
    "check": "pnpm typecheck && pnpm check:budget && pnpm lint && pnpm format:check && pnpm validate:content && pnpm test",
    "clean": "node tools/clean.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
