{
  "name": "ragequit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser PvP arena — 5v5 / 1v1 / FFA with element mastery and knockup combos.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev": "pnpm --filter=./packages/shared build && pnpm -r --parallel --filter=./packages/client --filter=./packages/server dev",
    "dev:client": "pnpm --filter=./packages/shared build && pnpm --filter=./packages/client dev",
    "dev:server": "pnpm --filter=./packages/shared build && pnpm --filter=./packages/server dev",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "validate:content": "tsx tools/content-validator/validate.ts",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
